                    }
                });
            });
        });

        // 3. Custom Video Logic (YouTube Embed)
        function playVideo() {
            var cover = document.getElementById('videoCover');
            var container = document.getElementById('videoFrame');
            
            // Hide the cover image
            cover.style.display = 'none';
            
            // Create the iframe
            var iframe = document.createElement('iframe');
            // IMPORTANT: Replace VIDEO ID
            iframe.src = "https://www.youtube.com/embed/M7398MO-oOE?autoplay=1&amp;rel=0&amp;modestbranding=1"; 
            iframe.width = "100%";
            iframe.height = "100%";
            iframe.frameBorder = "0";
            iframe.allow = "autoplay; fullscreen";
            
            // Append iframe to container
            container.appendChild(iframe);
        }
    </script>

